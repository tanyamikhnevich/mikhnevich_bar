// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum WineColor {
  red
  white
  rose
  sparkling
}

/// Курсы валют к шекелю на дату (кэш от внешнего API, обновляется ~раз в сутки).
/// `ils` — карта вида { "ILS": 1, "EUR": 3.98, "USD": 3.4, ... } (1 ед. валюты = X ₪).
model ExchangeRate {
  id        String   @id @default(cuid())
  date      String
  ils       Json
  fetchedAt DateTime @default(now())

  @@index([fetchedAt])
}

/// Пользователь (владелец коллекции). Сейчас логинимся одним аккаунтом;
/// в будущем к этой же таблице добавим регистрацию и привяжем вина к userId.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  wines Wine[]
}

model Wine {
  id           String    @id @default(cuid())
  // Владелец вина. Пока nullable — чтобы существующие вина мигрировали без потерь;
  // после привязки старых вин (scripts/assign-wines.ts) в коде всегда проставляется.
  userId       String?
  user         User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  producer     String
  year         String?
  country      String?
  countryCode  String?
  region       String?
  subregion    String?
  grape        String?

  purchasePrice Int?
  purchaseCurrency String?
  originPrice   Int?
  originCurrency   String?
  israelPrice   Int?
  israelCurrency   String?
  isGuestVisible   Boolean  @default(false)
  guestBottlePrice Int?
  guestGlassPrice  Int?

  purchaseDate DateTime?
  vivinoRating Float?
  ratings      String?

  quantity Int      @default(1)
  color    WineColor
  drank    Boolean  @default(false)
  drankAt      DateTime?
  drankRating  Float?
  drankNotes   String?
  notes    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, drank, color, createdAt])
  @@index([drank, drankAt])
}
